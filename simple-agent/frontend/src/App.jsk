import { useState } from 'react'

export default function App() {
  const [input, setInput] = useState('')
  const [log, setLog] = useState([])

  const submit = async () => {
    setLog(l => [...l, `> ${input}`])
    const res = await fetch('http://localhost:8000/task/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content: input })
    })
    const { task_id } = await res.json()
    
    // 轮询状态
    const timer = setInterval(async () => {
      const task = await (await fetch(`http://localhost:8000/task/${task_id}`)).json()
      if (task.status === 'success' || task.status === 'failed') {
        setLog(l => [...l, task.result || task.error, `--- 耗时 ${task.duration_ms.toFixed(0)}ms ---`])
        clearInterval(timer)
      }
    }, 500)
  }

  return (
    <div style={{padding:20, maxWidth:800, margin:'0 auto'}}>
      <h3>Mini Agent V4</h3>
      <input value={input} onChange={e=>setInput(e.target.value)} 
        style={{width:'80%', padding:8}} placeholder="输入任务..." />
      <button onClick={submit} style={{padding:'8px 20px', marginLeft:8}}>执行</button>
      <pre style={{marginTop:20, padding:15, background:'#f5f5f5', minHeight:300}}>
        {log.join('\n')}
      </pre>
    </div>
  )
}

